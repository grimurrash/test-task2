# Окружение и секреты — здесь их быть не должно ни при каких условиях
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
.npmrc
.netrc

# Агентская обвязка — часть работы, а не мусор.
# Глобальный ~/.gitignore_global первой строкой прячет .claude/ целиком; правило
# ниже возвращает её в репозиторий: .gitignore проекта старше глобального.
# Без этой строки хуки и workflow остаются только на диске, а в сдачу не едут.
!.claude/
.claude/logs/
.claude/state/

# Зависимости и сборка
node_modules/
vendor/
__pycache__/
*.pyc
.venv/
venv/
dist/
build/
coverage/
.phpunit.result.cache

# Системное
.DS_Store
*.swp
.idea/
.vscode/

# Рабочие копии ролей. Каждая роль работает в своей копии, чтобы параллельные
# сессии не делили один HEAD: 25 августа две из них столкнулись на переключении
# веток, и коммит ушёл в main в обход pull request. Копии лежат внутри
# репозитория, а не рядом с ним: запись за его пределы запрещена хуком
# guard-scope, и ослаблять этот запрет ради удобства не стоит.
# Убирать после слияния — командой удаления копии и последующей чисткой ссылок.
.worktrees/
